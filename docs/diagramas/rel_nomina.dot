novedad [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#dbeafe" colspan="3"><b>novedad</b></td></tr><tr><td align="left" port="id_novedad"><font point-size="9">PK</font></td><td align="left"><u>id_novedad</u></td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="id_nomina"><font point-size="9">FK</font></td><td align="left">id_nomina</td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="id_tipo_novedad"><font point-size="9">FK</font></td><td align="left">id_tipo_novedad</td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="fecha_inicio"><font point-size="9"> </font></td><td align="left">fecha_inicio</td><td align="left"><font color="#64748b" point-size="9">date</font></td></tr><tr><td align="left" port="fecha_fin"><font point-size="9"> </font></td><td align="left">fecha_fin</td><td align="left"><font color="#64748b" point-size="9">date</font></td></tr><tr><td align="left" port="dias"><font point-size="9"> </font></td><td align="left">dias</td><td align="left"><font color="#64748b" point-size="9">tinyint</font></td></tr></table>>];
parametro_nomina [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#dbeafe" colspan="3"><b>parametro_nomina</b></td></tr><tr><td align="left" port="id_parametro"><font point-size="9">PK</font></td><td align="left"><u>id_parametro</u></td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="clave"><font point-size="9">UQ</font></td><td align="left">clave</td><td align="left"><font color="#64748b" point-size="9">varchar(50)</font></td></tr><tr><td align="left" port="valor"><font point-size="9"> </font></td><td align="left">valor</td><td align="left"><font color="#64748b" point-size="9">decimal(14,4)</font></td></tr><tr><td align="left" port="descripcion"><font point-size="9"> </font></td><td align="left">descripcion</td><td align="left"><font color="#64748b" point-size="9">varchar(255)</font></td></tr></table>>];
dependencia -> empleado:id_dependencia;
cargo -> empleado:id_cargo;
eps -> empleado:id_eps;
arl -> empleado:id_arl;
fondo_pension -> empleado:id_fondo_pension;
empleado -> nomina_mensual:codigo_empleado;
periodo -> nomina_mensual:id_periodo;
nomina_mensual -> novedad:id_nomina;
tipo_novedad -> novedad:id_tipo_novedad;
}
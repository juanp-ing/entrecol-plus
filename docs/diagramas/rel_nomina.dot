nomina_mensual [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#dbeafe" colspan="3"><b>nomina_mensual</b></td></tr><tr><td align="left" port="id_nomina"><font point-size="9">PK</font></td><td align="left"><u>id_nomina</u></td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="codigo_empleado"><font point-size="9">FK UQ</font></td><td align="left">codigo_empleado</td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="id_periodo"><font point-size="9">FK UQ</font></td><td align="left">id_periodo</td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="dias_trabajados"><font point-size="9"> </font></td><td align="left">dias_trabajados</td><td align="left"><font color="#64748b" point-size="9">tinyint</font></td></tr><tr><td align="left" port="bonificacion"><font point-size="9"> </font></td><td align="left">bonificacion</td><td align="left"><font color="#64748b" point-size="9">decimal(12,2)</font></td></tr><tr><td align="left" port="transporte"><font point-size="9"> </font></td><td align="left">transporte</td><td align="left"><font color="#64748b" point-size="9">decimal(12,2)</font></td></tr></table>>];

digraph G { rankdir=LR; dpi=200; nodesep=0.35; ranksep=1.1; splines=spline;
node [shape=plaintext, fontname="Helvetica"]; edge [arrowhead=crowodot, arrowtail=teetee, dir=both, color="#334155", penwidth=1.2];
dependencia [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#dbeafe" colspan="3"><b>dependencia</b></td></tr><tr><td align="left" port="id_dependencia"><font point-size="9">PK</font></td><td align="left"><u>id_dependencia</u></td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="nombre_dependencia"><font point-size="9">UQ</font></td><td align="left">nombre_dependencia</td><td align="left"><font color="#64748b" point-size="9">varchar(80)</font></td></tr></table>>];

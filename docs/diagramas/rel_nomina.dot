arl [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#dbeafe" colspan="3"><b>arl</b></td></tr><tr><td align="left" port="id_arl"><font point-size="9">PK</font></td><td align="left"><u>id_arl</u></td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="nombre_arl"><font point-size="9">UQ</font></td><td align="left">nombre_arl</td><td align="left"><font color="#64748b" point-size="9">varchar(80)</font></td></tr></table>>];

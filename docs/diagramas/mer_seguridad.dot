graph MER_Seg {
  layout=neato; overlap=false; dpi=200;
  node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=10, penwidth=1.2];
  node [shape=box, style=filled, fillcolor="#fee2e2", penwidth=1.5];
  ROL [pos="0,0!"]; USUARIO [pos="5,0!"]; AUDITORIA_DATOS [pos="0,-3.5!"]; AUDITORIA_EVENTO [pos="5.5,-3.5!"];
  node [shape=diamond, style=filled, fillcolor="#fef3c7", fontsize=9, height=0.6];
  t1 [label="asigna", pos="2.5,0!"];
  ROL -- t1 [label="1"]; t1 -- USUARIO [label="N"];
  node [shape=ellipse, style=filled, fillcolor="#ffffff", fontsize=9, height=0.35];
  r1 [label=<<u>nombre_rol</u>>, pos="-1,1.2!"]; r2 [label="descripcion", pos="1,1.2!"]; ROL -- r1; ROL -- r2;
  u1 [label=<<u>nombre_usuario</u>>, pos="4,1.4!"]; u2 [label="nombre_completo", pos="6.4,1.3!"]; u3 [label="password_hash\n(bcrypt)", pos="7.2,0!"];
  u4 [label="activo", pos="6.2,-1.1!"]; u5 [label="fecha_creacion", pos="4,-1.2!"];
  USUARIO -- u1; USUARIO -- u2; USUARIO -- u3; USUARIO -- u4; USUARIO -- u5;
  d1 [label="tabla, operacion, llave", pos="-2.3,-2.4!"]; d2 [label="valores_antes /\nvalores_despues (JSON)", pos="-2.6,-4.5!"];
  d3 [label="usuario_app,\nusuario_bd, fecha", pos="0.5,-5!"];
  AUDITORIA_DATOS -- d1; AUDITORIA_DATOS -- d2; AUDITORIA_DATOS -- d3;
  v1 [label="tipo", pos="4,-4.6!"]; v2 [label="usuario_app, ip", pos="6,-4.9!"]; v3 [label="detalle, fecha", pos="7.8,-3.5!"];
  AUDITORIA_EVENTO -- v1; AUDITORIA_EVENTO -- v2; AUDITORIA_EVENTO -- v3;
}

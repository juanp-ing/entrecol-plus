graph MER_Nomina {
  layout=neato; overlap=false; splines=true; sep="+12"; dpi=200;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10];
  // Entidades
  node [shape=box, style="filled", fillcolor="#dbeafe", penwidth=1.5];
  EMPLEADO [pos="0,0!"]; DEPENDENCIA [pos="-5,2.6!"]; CARGO [pos="-5,-2.6!"];
  EPS [pos="-2.2,5!"]; ARL [pos="2.2,5!"]; FONDO_PENSION [label="FONDO_PENSION", pos="5,2.6!"];
  NOMINA_MENSUAL [pos="5,-2.6!"]; PERIODO [pos="9.5,-0.2!"]; NOVEDAD [pos="5,-7!"]; TIPO_NOVEDAD [pos="9.5,-7!"];
  PARAMETRO_NOMINA [pos="-5,-6.5!"];
  // Relaciones
  node [shape=diamond, style="filled", fillcolor="#fef3c7", fontsize=9, height=0.6];
  r1 [label="pertenece", pos="-2.6,1.3!"]; r2 [label="ocupa", pos="-2.6,-1.3!"];
  r3 [label="afiliado\nEPS", pos="-1.1,2.6!"]; r4 [label="afiliado\nARL", pos="1.1,2.6!"];
  r5 [label="cotiza", pos="2.6,1.3!"]; r6 [label="liquida", pos="2.6,-1.3!"];
  r7 [label="corresponde", pos="7.4,-1.4!"]; r8 [label="registra", pos="5,-4.8!"]; r9 [label="clasifica", pos="7.3,-7!"];
  edge [penwidth=1.2];
  DEPENDENCIA -- r1 [label="1"]; r1 -- EMPLEADO [label="N"];
  CARGO -- r2 [label="1"]; r2 -- EMPLEADO [label="N"];
  EPS -- r3 [label="1"]; r3 -- EMPLEADO [label="N"];
  ARL -- r4 [label="1"]; r4 -- EMPLEADO [label="N"];
  FONDO_PENSION -- r5 [label="1"]; r5 -- EMPLEADO [label="N"];
  EMPLEADO -- r6 [label="1"]; r6 -- NOMINA_MENSUAL [label="N"];
  PERIODO -- r7 [label="1"]; r7 -- NOMINA_MENSUAL [label="N"];
  NOMINA_MENSUAL -- r8 [label="1"]; r8 -- NOVEDAD [label="N"];
  TIPO_NOVEDAD -- r9 [label="1"]; r9 -- NOVEDAD [label="N"];
  // Atributos (claves subrayadas con <u>)
  node [shape=ellipse, style=filled, fillcolor="#ffffff", fontsize=9, height=0.35];
  a1 [label=<<u>codigo_empleado</u>>, pos="-0.9,-1.4!"]; a2 [label="nombre completo\n(apellidos, nombres)", pos="0.9,-1.6!"];
  a3 [label="fecha_ingreso", pos="-1.3,-2.6!"]; a4 [label="salario", pos="0.6,-2.8!"];
  EMPLEADO -- a1; EMPLEADO -- a2; EMPLEADO -- a3; EMPLEADO -- a4;
  b1 [label=<<u>anio, mes</u>>, pos="11.2,0.8!"]; PERIODO -- b1;
  c1 [label="dias_trabajados", pos="3.2,-3.6!"]; c2 [label="bonificacion", pos="6.8,-3.7!"]; c3 [label="transporte", pos="7.4,-2.7!"];
  NOMINA_MENSUAL -- c1; NOMINA_MENSUAL -- c2; NOMINA_MENSUAL -- c3;
  d1 [label="fecha_inicio", pos="3,-8!"]; d2 [label="fecha_fin", pos="4.6,-8.4!"]; d3 [label="dias", pos="6.2,-8.3!"];
  NOVEDAD -- d1; NOVEDAD -- d2; NOVEDAD -- d3;
  e1 [label=<<u>clave</u>>, pos="-6.7,-7.4!"]; e2 [label="valor", pos="-5,-7.7!"]; e3 [label="descripcion", pos="-3.3,-7.4!"];
  PARAMETRO_NOMINA -- e1; PARAMETRO_NOMINA -- e2; PARAMETRO_NOMINA -- e3;
  f1 [label=<<u>nombre_dependencia</u>>, pos="-7,3.5!"]; DEPENDENCIA -- f1;
  f2 [label=<<u>nombre_cargo</u>>, pos="-7,-3.5!"]; CARGO -- f2;
  f3 [label=<<u>nombre_eps</u>>, pos="-3.4,6!"]; EPS -- f3;
  f4 [label=<<u>nombre_arl</u>>, pos="3.4,6!"]; ARL -- f4;
  f5 [label=<<u>nombre_fondo</u>>, pos="7,3.5!"]; FONDO_PENSION -- f5;
  f6 [label=<<u>nombre_tipo</u>>, pos="11.3,-7.9!"]; TIPO_NOVEDAD -- f6;
}

digraph G { rankdir=LR; dpi=200; nodesep=0.35; ranksep=1.1; splines=spline;
node [shape=plaintext, fontname="Helvetica"]; edge [arrowhead=crowodot, arrowtail=teetee, dir=both, color="#334155", penwidth=1.2];
rol [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fee2e2" colspan="3"><b>rol</b></td></tr><tr><td align="left" port="id_rol"><font point-size="9">PK</font></td><td align="left"><u>id_rol</u></td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="nombre_rol"><font point-size="9">UQ</font></td><td align="left">nombre_rol</td><td align="left"><font color="#64748b" point-size="9">varchar(30)</font></td></tr><tr><td align="left" port="descripcion"><font point-size="9"> </font></td><td align="left">descripcion</td><td align="left"><font color="#64748b" point-size="9">varchar(255)</font></td></tr></table>>];
usuario [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fee2e2" colspan="3"><b>usuario</b></td></tr><tr><td align="left" port="id_usuario"><font point-size="9">PK</font></td><td align="left"><u>id_usuario</u></td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="nombre_usuario"><font point-size="9">UQ</font></td><td align="left">nombre_usuario</td><td align="left"><font color="#64748b" point-size="9">varchar(50)</font></td></tr><tr><td align="left" port="nombre_completo"><font point-size="9"> </font></td><td align="left">nombre_completo</td><td align="left"><font color="#64748b" point-size="9">varchar(120)</font></td></tr><tr><td align="left" port="password_hash"><font point-size="9"> </font></td><td align="left">password_hash</td><td align="left"><font color="#64748b" point-size="9">char(60)</font></td></tr><tr><td align="left" port="id_rol"><font point-size="9">FK</font></td><td align="left">id_rol</td><td align="left"><font color="#64748b" point-size="9">int</font></td></tr><tr><td align="left" port="activo"><font point-size="9"> </font></td><td align="left">activo</td><td align="left"><font color="#64748b" point-size="9">tinyint(1)</font></td></tr><tr><td align="left" port="fecha_creacion"><font point-size="9"> </font></td><td align="left">fecha_creacion</td><td align="left"><font color="#64748b" point-size="9">datetime</font></td></tr></table>>];
auditoria_datos [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fee2e2" colspan="3"><b>auditoria_datos</b></td></tr><tr><td align="left" port="id_auditoria"><font point-size="9">PK</font></td><td align="left"><u>id_auditoria</u></td><td align="left"><font color="#64748b" point-size="9">bigint</font></td></tr><tr><td align="left" port="tabla"><font point-size="9"> </font></td><td align="left">tabla</td><td align="left"><font color="#64748b" point-size="9">varchar(64)</font></td></tr><tr><td align="left" port="operacion"><font point-size="9"> </font></td><td align="left">operacion</td><td align="left"><font color="#64748b" point-size="9">enum('insert','update','delete')</font></td></tr><tr><td align="left" port="llave"><font point-size="9"> </font></td><td align="left">llave</td><td align="left"><font color="#64748b" point-size="9">varchar(100)</font></td></tr><tr><td align="left" port="valores_antes"><font point-size="9"> </font></td><td align="left">valores_antes</td><td align="left"><font color="#64748b" point-size="9">longtext</font></td></tr><tr><td align="left" port="valores_despues"><font point-size="9"> </font></td><td align="left">valores_despues</td><td align="left"><font color="#64748b" point-size="9">longtext</font></td></tr><tr><td align="left" port="usuario_app"><font point-size="9"> </font></td><td align="left">usuario_app</td><td align="left"><font color="#64748b" point-size="9">varchar(50)</font></td></tr><tr><td align="left" port="usuario_bd"><font point-size="9"> </font></td><td align="left">usuario_bd</td><td align="left"><font color="#64748b" point-size="9">varchar(100)</font></td></tr><tr><td align="left" port="fecha"><font point-size="9"> </font></td><td align="left">fecha</td><td align="left"><font color="#64748b" point-size="9">datetime</font></td></tr></table>>];
auditoria_evento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fee2e2" colspan="3"><b>auditoria_evento</b></td></tr><tr><td align="left" port="id_evento"><font point-size="9">PK</font></td><td align="left"><u>id_evento</u></td><td align="left"><font color="#64748b" point-size="9">bigint</font></td></tr><tr><td align="left" port="tipo"><font point-size="9"> </font></td><td align="left">tipo</td><td align="left"><font color="#64748b" point-size="9">enum('login_ok','login_fallido','logout','acceso','reporte','carga_archivo')</font></td></tr><tr><td align="left" port="usuario_app"><font point-size="9"> </font></td><td align="left">usuario_app</td><td align="left"><font color="#64748b" point-size="9">varchar(50)</font></td></tr><tr><td align="left" port="detalle"><font point-size="9"> </font></td><td align="left">detalle</td><td align="left"><font color="#64748b" point-size="9">varchar(500)</font></td></tr><tr><td align="left" port="ip"><font point-size="9"> </font></td><td align="left">ip</td><td align="left"><font color="#64748b" point-size="9">varchar(45)</font></td></tr><tr><td align="left" port="fecha"><font point-size="9"> </font></td><td align="left">fecha</td><td align="left"><font color="#64748b" point-size="9">datetime</font></td></tr></table>>];
rol -> usuario:id_rol;
}
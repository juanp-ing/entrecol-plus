# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.

# --- Base de datos (MariaDB 10.6+) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=entrecol_db
DB_USER=entrecol_app
DB_PASSWORD=cambie_esta_clave

# --- Flask ---
# Genere una con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambie_esta_clave_secreta

# --- Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google reCAPTCHA v2 (https://www.google.com/recaptcha/admin) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Cargas masivas ---
MAX_UPLOAD_MB=20

# Copia este archivo a .env y ajusta los valores
DB_HOST=localhost
DB_PORT=3306
DB_NAME=entrecol
DB_USER=entrecol_app
DB_PASSWORD=cambia-esta-clave

JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
